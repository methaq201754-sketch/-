{
  "expo": {
    "name": "السيارات - أطلس",
    "slug": "ycpd-fleet-app",
    "version": "1.14.0",
    "orientation": "portrait",
    "icon": "./icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0d47a1"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.atlas.fleet.ycpd",
      "versionCode": 25,
      "adaptiveIcon": {
        "foregroundImage": "./icon.png",
        "backgroundColor": "#0d47a1"
      }
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "للسماح باختيار صور المرفقات من المعرض",
          "cameraPermission": "للسماح بالتقاط صور المرفقات"
        }
      ]
    ]
  }
}
